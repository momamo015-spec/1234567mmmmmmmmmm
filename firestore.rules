rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'avatarColor', 'preferredEngine', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'avatarColor', 'preferredEngine', 'theme', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.avatarColor is string && data.avatarColor.size() >= 1 && data.avatarColor.size() <= 32
        && data.preferredEngine is string && data.preferredEngine.size() <= 32 && data.preferredEngine in ['hybrid', 'google', 'duckduckgo']
        && data.theme is string && data.theme.size() <= 16 && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryItem(data) {
      return data.keys().hasAll(['uid', 'query', 'engineMode', 'tab', 'createdAt'])
        && data.keys().hasOnly(['uid', 'query', 'engineMode', 'tab', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == request.auth.uid
        && data.query is string && data.query.size() >= 1 && data.query.size() <= 500
        && data.engineMode is string && data.engineMode.size() <= 32 && data.engineMode in ['hybrid', 'google', 'duckduckgo']
        && data.tab is string && data.tab.size() <= 32 && data.tab in ['all', 'images', 'videos', 'news', 'drive']
        && data.createdAt is timestamp;
    }

    function isValidBookmarkItem(data) {
      return data.keys().hasAll(['uid', 'title', 'url', 'snippet', 'displayLink', 'sourceType', 'createdAt'])
        && data.keys().hasOnly(['uid', 'title', 'url', 'snippet', 'displayLink', 'sourceType', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 2000
        && data.snippet is string && data.snippet.size() <= 1000
        && data.displayLink is string && data.displayLink.size() <= 256
        && data.sourceType is string && data.sourceType.size() >= 1 && data.sourceType.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidShortcutItem(data) {
      return data.keys().hasAll(['uid', 'title', 'url', 'iconColor', 'createdAt'])
        && data.keys().hasOnly(['uid', 'title', 'url', 'iconColor', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 1000
        && data.iconColor is string && data.iconColor.size() >= 1 && data.iconColor.size() <= 32
        && data.createdAt is timestamp;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    match /users/{userId} {
      allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarColor', 'preferredEngine', 'theme', 'email', 'updatedAt']);
      allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId);

      match /history/{historyId} {
        allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(historyId);
        allow list: if isVerifiedUser() && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && isValidHistoryItem(incoming())
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(historyId);
      }

      match /bookmarks/{bookmarkId} {
        allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isVerifiedUser() && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(bookmarkId)
          && isValidBookmarkItem(incoming())
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }

      match /shortcuts/{shortcutId} {
        allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(shortcutId);
        allow list: if isVerifiedUser() && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(shortcutId)
          && isValidShortcutItem(incoming())
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(shortcutId)
          && isValidShortcutItem(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'iconColor']);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(shortcutId);
      }
    }
  }
}
